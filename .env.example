# Copy to .env.local for local dev, and set the same keys in your Vercel project.

# Secret used to sign session cookies. Use a long random string.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The shared password you give to viewers (teachers, classmates).
VIEWER_PASSWORD=

# Your own password for the dashboard. Keep this one private.
ADMIN_PASSWORD=

# Postgres connection string (Neon, Vercel Postgres, or any Postgres).
# Leave empty to run on read-only sample data.
DATABASE_URL=

# Token for image uploads via Vercel Blob. Optional: you can paste image URLs
# instead. On Vercel this is added automatically when you create a Blob store.
BLOB_READ_WRITE_TOKEN=
